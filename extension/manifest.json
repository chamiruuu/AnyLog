{
  "manifest_version": 3,
  "name": "AnyLog Team Filler",
  "description": "Internal provider launcher and secure form filler synced through a backend config proxy.",
  "version": "1.0.0",
  "action": {
    "default_title": "AnyLog Team Filler",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon2.png",
      "32": "icons/icon2.png",
      "48": "icons/icon2.png",
      "128": "icons/icon2.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "storage.js",
        "formFiller.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon2.png",
    "32": "icons/icon2.png",
    "48": "icons/icon2.png",
    "128": "icons/icon2.png"
  }
}
